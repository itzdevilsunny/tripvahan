# Tripvahan Staging Environment Template
# Copy this file to .env.staging.local and fill with your 'tripvahan-staging' credentials
# DO NOT COMMIT .env.staging.local (it is ignored by .gitignore)

STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key-here
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key-here
