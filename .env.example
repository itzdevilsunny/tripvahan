# ==============================================================================
# TRIPVAHAN ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in Vercel Project Settings > Environment Variables.
# NEVER commit .env.local or real secrets to version control.

# --- Public Client Configuration (Browser & Server) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# --- Privileged Server-Only Configuration (SERVER ONLY - NEVER EXPOSE IN CLIENT) ---
# Required for server-side operator document signing and admin operator verification
# Obtain from: Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# --- Optional Test Configuration ---
# TEST_BASE_URL=http://localhost:3002

